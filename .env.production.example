# Production environment for compose.production.yml (single-container deploy).
#
#   cp .env.production.example .env.production
#   php artisan key:generate --show     # paste into APP_KEY
#   docker compose --env-file .env.production -f compose.production.yml up -d --build
#
# The --env-file flag is required: compose reads ${VAR} placeholders from it, not
# from the service-level env_file entry.

# ─── Docker / Caddy ───────────────────────────────────────────────────────────
# APP_DOMAIN must already resolve to this VPS, and port 80 must be reachable
# from the internet for the Let's Encrypt HTTP-01 challenge.
APP_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com
RUN_MIGRATIONS=true

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Matches
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Base URL of the Nuxt frontend, used to build password-reset links.
APP_FRONTEND_URL=https://example.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Rome

# ─── Logging ──────────────────────────────────────────────────────────────────
# stderr, not the default stack: file logs are invisible to `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─── Database ─────────────────────────────────────────────────────────────────
# DB_HOST is forced to `pgsql` by compose. DB_DATABASE / DB_USERNAME / DB_PASSWORD
# are also read by the postgres service — changing them after the first boot does
# NOT recreate the database.
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=matches
DB_USERNAME=matches
DB_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_HOST is forced to `redis` by compose.
REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─── Auth / CORS ──────────────────────────────────────────────────────────────
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=example.com
CORS_ALLOWED_ORIGINS=https://example.com

# ─── Broadcasting (Reverb) ────────────────────────────────────────────────────
# Server-side values: the app publishes to Reverb over loopback inside the
# container. The browser connects to wss://${APP_DOMAIN}/app/${REVERB_APP_KEY}
# through Caddy, so the frontend uses port 443 / scheme https instead.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false

# ─── Horizon ──────────────────────────────────────────────────────────────────
# Basic-auth for the /horizon dashboard. Leave empty only if the route is blocked
# at another layer — the dashboard exposes job payloads.
HORIZON_USERNAME=
HORIZON_PASSWORD=

# ─── Storage (S3-compatible, used by medialibrary) ────────────────────────────
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Backups (spatie/laravel-backup) ──────────────────────────────────────────
BACKUP_DISK=s3
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=you@example.com

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
