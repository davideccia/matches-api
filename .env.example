# ─── SAIL / DOCKER ───────────────────────────────────────────────────────────

# Host user/group — Sail sets these automatically via vendor/bin/sail up
APP_PORT=8080
FORWARD_REVERB_PORT=8081
FORWARD_DB_PORT=8082
FORWARD_REDIS_PORT=8083
FORWARD_MAILPIT_PORT=8084
FORWARD_MAILPIT_DASHBOARD_PORT=8085

# Xdebug — set SAIL_XDEBUG_MODE=develop,debug to enable step debugging
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# ─── APPLICATION ─────────────────────────────────────────────────────────────

APP_NAME=Matches
# Options: local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost:${APP_PORT}"
# Used for CORS allowed origins and links in outgoing emails
APP_FRONTEND_URL=http://localhost:3000

# ─── LOCALIZATION ─────────────────────────────────────────────────────────────

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# ─── MAINTENANCE ──────────────────────────────────────────────────────────────

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ─── SECURITY ─────────────────────────────────────────────────────────────────

# Higher values increase security but slow down password hashing
BCRYPT_ROUNDS=12

# ─── LOGGING ──────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Options: debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

# ─── DATABASE ─────────────────────────────────────────────────────────────────

# sqlite for local dev; switch to mysql or pgsql in production
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=matches_api
DB_USERNAME=sail
DB_PASSWORD=password

# ─── SESSION ──────────────────────────────────────────────────────────────────

# 'database' driver stores sessions in the sessions table
SESSION_DRIVER=database
# Session lifetime in minutes
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── BROADCASTING, FILESYSTEM & QUEUE ────────────────────────────────────────

# MatchRecordChanged events are broadcast on tournaments.{id}.match_records
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# 'redis' required for Horizon (sync and database are not supported by Horizon)
QUEUE_CONNECTION=redis

# ─── REVERB (WEBSOCKETS) ─────────────────────────────────────────────────────

# Set BROADCAST_CONNECTION=reverb above to enable real-time broadcasting
# eg: MatchRecordChanged events are pushed on tournaments.{id}.match_records
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── CACHE ────────────────────────────────────────────────────────────────────

# 'database' in dev; redis is recommended in production
CACHE_STORE=redis
# CACHE_PREFIX=

# ─── MEMCACHED ────────────────────────────────────────────────────────────────

MEMCACHED_HOST=127.0.0.1

# ─── REDIS ────────────────────────────────────────────────────────────────────

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── HORIZON ─────────────────────────────────────────────────────────────────

# HTTP Basic Auth credentials for the /horizon dashboard
HORIZON_USERNAME=horizon
HORIZON_PASSWORD=secret

# ─── MAIL ─────────────────────────────────────────────────────────────────────

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BACKUP_NOTIFICATION_EMAIL="hello@example.com"

# ─── AWS / FILE STORAGE ───────────────────────────────────────────────────────

# Required only when FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Custom endpoint for S3-compatible services (MinIO, Localstack, etc.)
# Leave empty to use the standard AWS endpoint
AWS_ENDPOINT=
# Public base URL used to generate asset URLs (e.g. http://localhost:9000/bucket)
# Leave empty to let Laravel derive it from endpoint + bucket
AWS_URL=
# Must be true when using a custom AWS_ENDPOINT (path-style: endpoint/bucket/key)
# False for standard AWS (virtual-hosted-style: bucket.s3.region.amazonaws.com)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── FRONTEND (VITE) ──────────────────────────────────────────────────────────

# Variables prefixed VITE_ are exposed to the JS bundle at build time
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
