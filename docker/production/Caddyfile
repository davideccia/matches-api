{
	email {$LETSENCRYPT_EMAIL}
}

# Internal healthcheck: the container has no DNS entry for its own domain.
# Goes through php-fpm on purpose, so a dead PHP pool fails the healthcheck.
http://localhost {
	root * /var/www/public
	php_fastcgi 127.0.0.1:9000
}

{$APP_DOMAIN} {
	root * /var/www/public
	encode zstd gzip

	# Reverb websocket over TLS -> wss://{$APP_DOMAIN}/app/{key}
	# /apps/* (the broadcast API) is deliberately NOT proxied: the app publishes
	# to 127.0.0.1:{$REVERB_PORT} from inside this container.
	handle /app/* {
		reverse_proxy 127.0.0.1:{$REVERB_PORT}
	}

	@hidden {
		path /.*
		not path /.well-known/*
	}
	respond @hidden 403

	php_fastcgi 127.0.0.1:9000
	file_server

	request_body {
		max_size 100MB
	}

	log
}
