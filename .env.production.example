# ─── CONTAINER / ENTRYPOINT ──────────────────────────────────────────────────

# entrypoint.sh: false salta `artisan migrate --force` all'avvio.
RUN_MIGRATIONS=true

# ─── APPLICATION ─────────────────────────────────────────────────────────────

APP_NAME=Matches
# Options: local | staging | production
APP_ENV=production
# Generate with: `echo "base64:$(openssl rand -base64 32)"`
APP_KEY=
APP_DEBUG=false
# L'URL pubblico dietro il reverse proxy (in locale: la PROD_APP_PORT mappata)
APP_URL=http://localhost:8090
# Used for CORS allowed origins and links in outgoing emails
APP_FRONTEND_URL=http://localhost:3000

# ─── LOCALIZATION ─────────────────────────────────────────────────────────────

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# ─── MAINTENANCE ──────────────────────────────────────────────────────────────

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ─── SECURITY ─────────────────────────────────────────────────────────────────

# Higher values increase security but slow down password hashing
BCRYPT_ROUNDS=12
# Mai * in produzione: elenca gli origin del frontend, separati da virgola
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=""
# Minutes until an issued Sanctum token expires server-side (10080 = 7 days, matching the frontend cookie)
SANCTUM_EXPIRATION=10080

# ─── BACKUP ───────────────────────────────────────────────────────────────────

# Default is the local disk (storage/backups, bind-mountable as a Docker volume).
# Point BACKUP_DISK at s3-backup (and fill in the BACKUP_AWS_* vars below) to back up to S3 instead.
BACKUP_ENABLED=true
BACKUP_DISK=local-backup
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_BUCKET=
BACKUP_AWS_URL=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=hello@example.com

# ─── LOGGING ──────────────────────────────────────────────────────────────────

# 'daily' rotates the log file and prunes files older than LOG_DAILY_DAYS (12 months retention)
LOG_CHANNEL=daily
LOG_DAILY_DAYS=365
LOG_DEPRECATIONS_CHANNEL=null
# Options: debug | info | notice | warning | error | critical | alert | emergency
# L'app logga solo a livello warning (Log::warning): più in basso è solo rumore.
LOG_LEVEL=warning

# ─── DATABASE ─────────────────────────────────────────────────────────────────

# 'pgsql' è il nome del servizio nel compose; su VPS è l'host del database
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=matches_api
DB_USERNAME=sail
DB_PASSWORD=password

# ─── SESSION ──────────────────────────────────────────────────────────────────

# 'database' driver stores sessions in the sessions table
SESSION_DRIVER=database
# Session lifetime in minutes
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── BROADCASTING, FILESYSTEM & QUEUE ────────────────────────────────────────

# MatchRecordChanged events are broadcast on tournaments.{id}.match_records
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Disk used by spatie/laravel-medialibrary (falls back to FILESYSTEM_DISK, then 'public')
MEDIA_DISK=
# 'redis' required for Horizon (sync and database are not supported by Horizon)
QUEUE_CONNECTION=redis

# ─── REVERB (WEBSOCKETS) ─────────────────────────────────────────────────────

# REVERB_HOST/PORT/SCHEME sono ciò che viene detto ai CLIENT (reverb.<domain>:443
# dietro il proxy TLS), non dove il server ascolta: quella è REVERB_SERVER_PORT.
# REVERB_APP_KEY is NUXT_PUBLIC_REVERB_APP_KEY on frontend env var
REVERB_APP_ID=reverb
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8091
REVERB_SCHEME=http
# Porta su cui Reverb ASCOLTA (dentro il container). Default nell'immagine: 8080.
REVERB_SERVER_PORT=8080

# ─── CACHE ────────────────────────────────────────────────────────────────────

CACHE_STORE=redis
# Namespace delle chiavi di cache/sessione: se due ambienti condividono Redis
# DEVE differire, altrimenti si sovrascrivono a vicenda.
CACHE_PREFIX=matches_production_cache

# spatie/laravel-responsecache defaults to the 'file' store regardless of
# CACHE_STORE, which does not support cache tags. Match it to CACHE_STORE so
# tag-based invalidation (ResponseCache::clear(['tag'])) works.
RESPONSE_CACHE_DRIVER=redis

# ─── MEMCACHED ────────────────────────────────────────────────────────────────

MEMCACHED_HOST=127.0.0.1

# ─── REDIS ────────────────────────────────────────────────────────────────────

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis databases are numbered, not named. When several environments share the
# same Redis container, give each one its own pair of indexes (0-15).
# In locale il container di produzione gira accanto a Sail (che usa 0/1), quindi
# qui 4/5: cache, sessioni, code e metadati Horizon non si mischiano.
REDIS_DB=4
REDIS_CACHE_DB=5

# Key namespace, on top of the DB index. Defaults to a slug of APP_NAME, so it
# already differs per environment — set it explicitly to stop depending on that.
REDIS_PREFIX=matches_production-database-

# NOT read by Laravel — these two belong on the redis container itself. They are
# set on the redis service in compose.yaml; the production orchestration lives
# outside this repo, so mirror them there by hand.
#
# One Redis instance holds the queue (REDIS_DB), the cache (REDIS_CACHE_DB) and
# Horizon's metadata, and eviction is global across databases, so the policy is
# not optional:
#   - a bare number means BYTES. `--maxmemory 256` is 256 bytes, not 256 MB.
#   - `noeviction` (the Redis default) lets the unbounded cache fill the limit
#     and then fails EVERY write, including queue pushes.
#   - `volatile-lru` only evicts keys that carry a TTL — the cache and Horizon's
#     metrics. The queue list and the reserved-job set have no TTL, so queued
#     jobs are never dropped.

# ─── HORIZON ─────────────────────────────────────────────────────────────────

# HTTP Basic Auth credentials for the /horizon dashboard — CAMBIALE.
# Raggiungibile solo sulla porta admin (:8081), non da internet.
HORIZON_USERNAME=admin
HORIZON_PASSWORD=

# Redis key prefix for Horizon data. Defaults to a slug of APP_NAME. Two
# environments sharing a Redis container MUST NOT share it, or each dashboard
# lists the other's jobs.
HORIZON_PREFIX=matches_production_horizon:

# Recipient of the LongWaitDetected alert (horizon.waits: 60s on redis:default).
# On a single-VPS deployment this is the only signal that the workers stopped
# draining the queue. Unset disables the alert.
HORIZON_NOTIFICATION_EMAIL=

# ─── LOG-VIEWER ───────────────────────────────────────────────────────────────

LOG_VIEWER_ENABLED=true
LOG_VIEWER_PATH=log-viewer
LOG_VIEWER_USERNAME=admin
LOG_VIEWER_PASSWORD=

# ─── PULSE ────────────────────────────────────────────────────────────────────

# HTTP Basic Auth credentials for the /pulse dashboard
PULSE_USERNAME=admin
PULSE_PASSWORD=

# ─── MAIL ─────────────────────────────────────────────────────────────────────

# In locale è il mailpit di Sail (dashboard su FORWARD_MAILPIT_DASHBOARD_PORT,
# :8085): il container production lo ha in depends_on. Su VPS qui va l'SMTP vero.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS / FILE STORAGE ───────────────────────────────────────────────────────

# Required only when FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Custom endpoint for S3-compatible services (MinIO, Localstack, etc.)
# Leave empty to use the standard AWS endpoint
AWS_ENDPOINT=
# Public base URL used to generate asset URLs (e.g. http://localhost:9000/bucket)
# Leave empty to let Laravel derive it from endpoint + bucket
AWS_URL=
# Must be true when using a custom AWS_ENDPOINT (path-style: endpoint/bucket/key)
# False for standard AWS (virtual-hosted-style: bucket.s3.region.amazonaws.com)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── PDF ──────────────────────────────────────────────────────────────────────

# L'immagine non ha Chrome/Node: DOMPDF è l'unico driver che funziona qui.
LARAVEL_PDF_DRIVER=dompdf
